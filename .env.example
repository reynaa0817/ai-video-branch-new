# ai-video Story 1.3 local environment.
# Copy to .env in a secure local environment; never commit real secrets.

# MySQL root password for local-only development.
MYSQL_ROOT_PASSWORD=change-me-local

# MySQL business database name.
MYSQL_DATABASE=ai_video

# MinIO local administrator user.
MINIO_ROOT_USER=minioadmin

# MinIO local administrator password.
MINIO_ROOT_PASSWORD=change-me-local
